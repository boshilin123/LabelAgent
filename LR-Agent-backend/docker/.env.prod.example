# ── 生产部署配置模板 ─────────────────────────────────────────
# 使用：cp .env.prod.example .env.prod 并填写以下密钥与域名。
# 本文件会被 git 跟踪；.env.prod 已被 .gitignore 忽略。

# ── 域名（必填）───────────────────────────────────────────────
# 需要两条 DNS A 记录指向服务器 IP：
#   api.DOMAIN   （后端 API，Caddy 反代 + 自动 HTTPS）
#   minio.DOMAIN （MinIO，仅头像等对象公开读）
DOMAIN=example.com

# Let's Encrypt 通知邮箱（必填，证书续期通知）
ACME_EMAIL=you@example.com

# 前端客户端的访问域名，用于 CORS 白名单与邮箱验证链接
FRONTEND_HOST=app.example.com

# ── 安全（必填）───────────────────────────────────────────────
# 生成命令：openssl rand -hex 32
SECRET_KEY=

# ── PostgreSQL（必填）─────────────────────────────────────────
POSTGRES_USER=lr_agent
POSTGRES_DB=lr_agent
# 生成命令：openssl rand -hex 24
POSTGRES_PASSWORD=

# ── Redis（必填）──────────────────────────────────────────────
# 生成命令：openssl rand -hex 24
REDIS_PASSWORD=

# ── MinIO（必填）──────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
# 生成命令：openssl rand -hex 24
MINIO_ROOT_PASSWORD=

# ── SMTP（可选）───────────────────────────────────────────────
# SMTP_HOST 留空时，验证/重置邮件仅打印到日志（不真实发送）。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_USE_TLS=true