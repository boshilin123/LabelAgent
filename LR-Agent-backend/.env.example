# ── Application ──────────────────────────────────────────────
APP_NAME=LR-Agent API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ── Security ─────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-secret
LLM_BASE_URL_ALLOW_HTTP=false

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=lr_agent
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=lr_agent
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://lr_agent:change-me-postgres-password@localhost:5432/lr_agent

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password
REDIS_DB=0
REDIS_URL=redis://:change-me-redis-password@localhost:6379/0

# ── MinIO (Phase 2) ──────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio-password
MINIO_BUCKET=lr-agent-avatars
MINIO_SECURE=false
MINIO_PUBLIC_BASE_URL=http://localhost:9000/lr-agent-avatars

# ── Email (Phase 2) ──────────────────────────────────────────
# Leave SMTP_HOST empty to log verification/reset links instead of sending mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_USE_TLS=true
EMAIL_DEEP_LINK_BASE=lr-agent://
# Web page base for email verification links (no trailing slash).
# Use your LAN IP when verifying from a phone, e.g. http://192.168.1.100:1212
EMAIL_VERIFY_WEB_BASE=http://localhost:1212

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:1212"]

# ── Annotation（视觉映射）────────────────────────────────────
# off | auto | always — 整图 preflight 缩小标签候选池；auto=候选数比框数多 min_extra 时启用
ANNOTATION_LABEL_POOL_PREFLIGHT=auto
ANNOTATION_LABEL_POOL_PREFLIGHT_MIN_EXTRA=2
ANNOTATION_JUDGE_ENABLED=true
ANNOTATION_JUDGE_MAX_RETRIES=1
ANNOTATION_JUDGE_REJECT_SUBMIT_PARTIAL=true
ANNOTATION_JUDGE_TEMPERATURE=0.0
ANNOTATION_VISION_MAP_MAX_RETRIES=1
